# Ollama settings (local only)
OLLAMA_HOST=http://127.0.0.1:11434
# Small vision model — see README for alternatives
# gemma3:4b is stronger on real phone-scan receipts; e2b is faster but confuses cash/total more
MODEL=gemma3:4b

# App paths
DATA_DIR=data
DB_PATH=data/invoices.db
UPLOAD_DIR=data/uploads
